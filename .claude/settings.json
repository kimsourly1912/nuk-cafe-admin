{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh auth status)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh run download *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch origin *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test:unit *)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm view *)",
      "Bash(scripts/upgrade-verify.sh *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *:main)",
      "Bash(git push * main)",
      "Bash(gh pr merge *)",
      "Bash(pnpm deploy:staging *)",
      "Bash(pnpm db:migrate:staging *)",
      "Bash(pnpm db:migrate:production *)",
      "Bash(wrangler d1 migrations apply *--remote*)",
      "Bash(pnpm exec wrangler d1 migrations apply *--remote*)",
      "Bash(wrangler deploy)",
      "Bash(pnpm exec wrangler deploy --config *)"
    ]
  }
}
