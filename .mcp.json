{
  "mcpServers": {
    "chrome-devtools": {
      "command": "pnpm",
      "args": [
        "exec",
        "chrome-devtools-mcp",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--redactNetworkHeaders",
        "--allowedUrlPattern",
        "http://localhost:*/*",
        "--allowedUrlPattern",
        "http://127.0.0.1:*/*",
        "--headless=${CHROME_DEVTOOLS_MCP_HEADLESS:-false}"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      }
    }
  }
}
