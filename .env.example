# Nuxt Better Auth. Set a distinct secret of at least 32 high-entropy characters per environment.
NUXT_BETTER_AUTH_SECRET=

# Required for Better Auth on Cloudflare Workers, including workers.dev domains.
# NUXT_PUBLIC_SITE_URL=https://your-domain.example

# The zone schedule times are in (local wall time at the cafe). Defaults to Asia/Phnom_Penh.
# NUXT_PUBLIC_CAFE_TIME_ZONE=Asia/Phnom_Penh

# Account emails through Resend (docs/server/operations.md → Email). Without a key the dev server
# prints emails (with their links) to the console; production builds refuse to.
# NUXT_MAIL_RESEND_API_KEY=
# NUXT_MAIL_FROM="NUK Cafe <no-reply@your-domain.example>"

# First admin for the seed task (curl http://localhost:3000/_nitro/tasks/db:seed in dev).
# NUXT_SEED_ADMIN_EMAIL=
# NUXT_SEED_ADMIN_NAME=Admin
