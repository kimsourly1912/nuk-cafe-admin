# Base URL the browser uses to call the backend.
# Dev: keep the default "/api" (proxied by the Nuxt dev server, see nuxt.config.ts).
# Prod: must be same-site with the portal (e.g. portal on admin.nukcafe.co) because
# the backend's auth cookies are SameSite=Lax.
# NUXT_PUBLIC_API_BASE=/api

# Where the dev proxy forwards /api requests.
# API_PROXY_TARGET=https://dev-api.nukcafe.co/nukcafe/api/v2

# OpenAPI spec used by `pnpm api:generate`.
# OPENAPI_URL=https://dev-api.nukcafe.co/nukcafe/api/v2/api-docs
