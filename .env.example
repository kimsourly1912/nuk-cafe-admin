# Nuxt Better Auth. Set a distinct secret of at least 32 high-entropy characters per environment.
NUXT_BETTER_AUTH_SECRET=

# Required for Better Auth on Cloudflare Workers, including workers.dev domains.
# NUXT_PUBLIC_SITE_URL=https://your-domain.example

# First admin: enables POST /api/v1/bootstrap/admin while set (at least 32 random characters).
# Remove it once the first admin exists. See docs/reference/api.md → Identity.
# NUXT_BOOTSTRAP_TOKEN=

# The zone schedule times are in (local wall time at the cafe). Defaults to Asia/Phnom_Penh.
# NUXT_PUBLIC_CAFE_TIME_ZONE=Asia/Phnom_Penh
