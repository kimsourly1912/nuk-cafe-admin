# Nuxt Better Auth. Set a distinct secret of at least 32 high-entropy characters per environment.
NUXT_BETTER_AUTH_SECRET=

# Required for Better Auth on Cloudflare Workers, including workers.dev domains.
# NUXT_PUBLIC_SITE_URL=https://your-domain.example

# Temporary Spring API access for the unchanged admin screens.
# Development defaults to /legacy-api, forwarded by Nitro only in dev.
# LEGACY_API_PROXY_TARGET=https://dev-api.nukcafe.co/nukcafe/api/v2
# For a deployed app, use a same-site reverse-proxy path until the screens are ported.
# NUXT_PUBLIC_LEGACY_API_BASE=/nukcafe/api/v2
