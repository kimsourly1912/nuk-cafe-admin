# Nuxt Better Auth. Set a distinct secret of at least 32 high-entropy characters per environment.
NUXT_BETTER_AUTH_SECRET=

# Required for Better Auth on Cloudflare Workers, including workers.dev domains.
# NUXT_PUBLIC_SITE_URL=https://your-domain.example

# The zone schedule times are in (local wall time at the cafe). Defaults to Asia/Phnom_Penh.
# NUXT_PUBLIC_CAFE_TIME_ZONE=Asia/Phnom_Penh

# Account emails (docs/server/operations.md → Email, D212): deployed Workers send through their
# Cloudflare Email Sending binding, configured in nuxt.config.ts. The dev server has no binding and
# prints emails (with their links) to the console; production builds refuse to.
# The platform's name in the emails (default Angder, D213):
# NUXT_MAIL_APP_NAME=Angder

# Table QR codes (D91): a long random secret per environment. Changing it invalidates every printed QR.
# Without it the dev server uses a local secret; deployed builds refuse to serve table QRs.
# NUXT_QR_SECRET=

# The AI assistant (D107, D108; docs/server/operations.md → Configuration). Without a key it's off.
# NUXT_AI_PROVIDER=anthropic   # anthropic | openai | google | openai-compatible
# NUXT_AI_MODEL=
# NUXT_AI_API_KEY=
# NUXT_AI_BASE_URL=            # required for openai-compatible
# NUXT_AI_DAILY_LIMIT=100

# Telegram (D112; docs/server/operations.md → Telegram). Without a token it's off.
# NUXT_TELEGRAM_BOT_TOKEN=        # from @BotFather, a secret
# NUXT_TELEGRAM_BOT_USERNAME=     # e.g. NukCafeBot
# NUXT_TELEGRAM_WEBHOOK_SECRET=   # 32–256 letters, digits, _ or -

# Checking counter KHQRs with Bakong (D131; docs/server/operations.md → KHQR). Each cafe saves its
# own token on Payments; without the key none can be saved and cashiers confirm by hand.
# NUXT_BAKONG_ENCRYPTION_KEY=     # 32 random bytes, base64 (openssl rand -base64 32): seals each cafe's Bakong token (D148)
# NUXT_BAKONG_API_URL=            # default https://api-bakong.nbc.gov.kh

# Local accounts for every role (pnpm dev:accounts, D209). Default password nuk-dev-password.
# NUXT_DEV_ACCOUNTS_PASSWORD=

# The admin's Sample data page (D94): on for the dev server by default. Set to true on staging.
# Never in production: its routes answer 404 when off.
# NUXT_PUBLIC_SAMPLE_DATA_ENABLED=true
# NUXT_PUBLIC_SAMPLE_DATA_ENVIRONMENT=Local

# Account browser verification (D217): disabled locally by default. Deployed environment builds
# enable it and configure their own public sitekey; only the Worker secret binding holds the key.
# NUXT_HUMAN_CHECK_ENABLED=false
# NUXT_HUMAN_CHECK_SECRET=
# NUXT_PUBLIC_HUMAN_CHECK_ENABLED=false
# NUXT_PUBLIC_HUMAN_CHECK_SITE_KEY=
