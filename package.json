{
  "name": "nuk-cafe-admin",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "nuxt build",
    "build:staging": "nuxt build --envName staging",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
    "deploy:staging": "pnpm build:staging && pnpm db:migrate:staging && wrangler deploy --config .output/server/wrangler.json",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project server",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.11.2",
    "@nuxthub/core": "0.10.8",
    "@nuxtjs/better-auth": "0.3.5",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.3",
    "h3": "1.15.11",
    "nuxt": "^4.5.2",
    "ofetch": "^1.5.1",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.2",
    "valibot": "^1.5.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.136",
    "@libsql/client": "^0.18.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@types/sortablejs": "^1.15.9",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.141.0"
  }
}
