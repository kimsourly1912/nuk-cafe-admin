{
  "name": "nuk-cafe-admin",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "build": "nuxt build",
    "build:staging": "nuxt build --envName staging",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
    "deploy:staging": "pnpm build:staging && pnpm db:migrate:staging && wrangler deploy --config .output/server/wrangler.json",
    "build:production": "nuxt build --envName prod",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
    "dev": "nuxt dev",
    "dev:accounts": "node scripts/dev-accounts.mjs accounts",
    "dev:reset": "node scripts/dev-accounts.mjs reset",
    "dev:mail": "node scripts/dev-accounts.mjs mail",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project server",
    "test:changed": "vitest run --project unit --project server --changed origin/main",
    "test:fast": "vitest run --project unit --project server --tags-filter=!slow",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "nuxt typecheck && tsc -p ops/watchdog && tsc -p ops/backup"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.68",
    "@ai-sdk/google": "^4.0.85",
    "@ai-sdk/openai": "^4.0.80",
    "@ai-sdk/openai-compatible": "^3.0.59",
    "@ai-sdk/vue": "^4.0.122",
    "@internationalized/date": "^3.12.4",
    "@noble/hashes": "^2.4.0",
    "@nuxt/ui": "^4.12.0",
    "@nuxthub/core": "0.10.8",
    "@nuxtjs/better-auth": "0.3.7",
    "@tanstack/charts": "^1.1.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "ai": "^7.0.122",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "grammy": "^1.46.0",
    "h3": "1.15.11",
    "libphonenumber-js": "^1.13.14",
    "nuxt": "^4.6.1",
    "ofetch": "^1.5.1",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3",
    "uqr": "^0.1.3",
    "uuid": "^14.0.2",
    "valibot": "^1.5.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/circle-flags": "^1.2.12",
    "@iconify-json/lucide": "^1.2.136",
    "@libsql/client": "^0.18.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@types/sortablejs": "^1.15.9",
    "@vue/test-utils": "^2.5.1",
    "age-encryption": "0.3.1",
    "aws4fetch": "1.0.20",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.141.0"
  }
}
